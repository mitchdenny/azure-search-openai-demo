# Copy to .env. Shell/Aspire environment variables take precedence.
# Existing resources only: Aspire does not provision these services.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=content
AZURE_SEARCH_SERVICE=
AZURE_SEARCH_INDEX=gptkbindex
AZURE_OPENAI_SERVICE=
AZURE_OPENAI_CHATGPT_DEPLOYMENT=
AZURE_OPENAI_CHATGPT_MODEL=gpt-4.1-mini
AZURE_OPENAI_EMB_DEPLOYMENT=
AZURE_OPENAI_EMB_MODEL_NAME=text-embedding-ada-002
AZURE_OPENAI_EMB_DIMENSIONS=1536
# Optional for a non-home tenant. Authenticate separately with az login.
AZURE_TENANT_ID=
# Use local parsing unless an existing Document Intelligence service is supplied.
USE_LOCAL_PDF_PARSER=true
USE_LOCAL_HTML_PARSER=true
# Optional features keep their original environment variable names.
# AZURE_USE_AUTHENTICATION=true
# AZURE_CLIENT_APP_ID=
# AZURE_SERVER_APP_ID=
# AZURE_SERVER_APP_SECRET=
# AZURE_AUTH_TENANT_ID=
# AZURE_ENFORCE_ACCESS_CONTROL=true
