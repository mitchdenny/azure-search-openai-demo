# Standalone ingestion/admin utilities only; the AppHost and backend do not load this file.
# Copy to .env and fill in the resources created by the AppHost before authorized ingestion.
# Shell environment variables take precedence.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=content
AZURE_SEARCH_SERVICE=
AZURE_SEARCH_INDEX=gptkbindex
OPENAI_HOST=azure
AZURE_OPENAI_SERVICE=
# Use the actual endpoint from the backend's CHAT_URI in Aspire, not the resource name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHATGPT_DEPLOYMENT=chat
AZURE_OPENAI_CHATGPT_MODEL=gpt-4.1-mini
AZURE_OPENAI_EMB_DEPLOYMENT=embeddings
AZURE_OPENAI_EMB_MODEL_NAME=text-embedding-3-small
AZURE_OPENAI_EMB_DIMENSIONS=1536
# Optional for a non-home tenant. Authenticate separately with az login.
AZURE_TENANT_ID=
# Standalone ingestion uses local parsing instead of Document Intelligence.
USE_LOCAL_PDF_PARSER=true
USE_LOCAL_HTML_PARSER=true
# Optional admin utilities keep their original environment variable names.
# AZURE_USE_AUTHENTICATION=true
# AZURE_CLIENT_APP_ID=
# AZURE_SERVER_APP_ID=
# AZURE_SERVER_APP_SECRET=
# AZURE_AUTH_TENANT_ID=
# AZURE_ENFORCE_ACCESS_CONTROL=true
